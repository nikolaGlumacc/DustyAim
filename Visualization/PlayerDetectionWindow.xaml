<Window x:Class="Visualization.PlayerDetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Visualization"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Focusable="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        Closing="Window_Closing"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid SnapsToDevicePixels="True">
        <Border x:Name="DetectedPlayerFocus"
                Width="50"
                Height="50"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                BorderBrush="Red"
                SnapsToDevicePixels="True"/>
        <Border x:Name="UnfilteredPlayerFocus"
                Width="50"
                Height="50"
                BorderBrush="#FF8800FF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                IsEnabled="False"
                SnapsToDevicePixels="True"/>
        <Border x:Name="PredictionFocus"
                Width="50"
                Height="50"
                BorderBrush="#FF4EFF00"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" 
                Visibility="Collapsed"
                IsHitTestVisible="False"
                IsEnabled="False"
                SnapsToDevicePixels="True"/>

    </Grid>
</Window>
