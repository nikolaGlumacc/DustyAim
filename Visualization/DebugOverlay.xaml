<Window x:Class="Visualization.DebugOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DustyAim Debug"
        Width="520"
        Height="560"
        MinWidth="440"
        MinHeight="460"
        WindowStyle="ToolWindow"
        Topmost="True"
        ResizeMode="CanResize"
        Background="#F20B0D10"
        Foreground="White"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="10"
        Top="10"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="DebugActionButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#1A2A33"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30424D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Live Debugger" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F4FFFFFF"/>
                <TextBlock x:Name="HealthSummary" Text="Waiting for runtime data"
                           Foreground="#9EADB7" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#10262E" BorderBrush="#264C58" BorderThickness="1"
                    CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                <TextBlock x:Name="HealthBadge" Text="IDLE" Foreground="#9EADB7"
                           FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#12161A" BorderBrush="#263039" BorderThickness="1"
                CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Loop Running:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="LoopStatus" Grid.Row="0" Grid.Column="1" Text="NO" Foreground="#FF6666" FontSize="11" FontWeight="Bold"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Frame Delta:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="FrameDelta" Grid.Row="0" Grid.Column="3" Text="0" Foreground="White" FontSize="11"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inference Calls:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="FrameCount" Grid.Row="1" Grid.Column="1" Text="0" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Inference FPS:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="InferenceFPS" Grid.Row="1" Grid.Column="3" Text="0" Foreground="White" FontSize="11"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Detections/sec:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="DetectCount" Grid.Row="2" Grid.Column="1" Text="0" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Max Confidence:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="MaxConf" Grid.Row="2" Grid.Column="3" Text="0.000" Foreground="White" FontSize="11"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Threshold:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="Threshold" Grid.Row="3" Grid.Column="1" Text="0.50" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Model Style:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="ModelStyle" Grid.Row="3" Grid.Column="3" Text="?" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Anchors:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="Anchors" Grid.Row="4" Grid.Column="1" Text="0" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="DPI Scale:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="DpiInfo" Grid.Row="4" Grid.Column="3" Text="1.0x1.0" Foreground="White" FontSize="11"/>

                <Border Grid.Row="5" Grid.ColumnSpan="4" BorderBrush="#2D3840" BorderThickness="0,1,0,0" Margin="0,6"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Capture X,Y:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="CaptureXY" Grid.Row="6" Grid.Column="1" Text="?" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Capture Size:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="CaptureSize" Grid.Row="6" Grid.Column="3" Text="?" Foreground="White" FontSize="11"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Screen Physical:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="ScreenSize" Grid.Row="7" Grid.Column="1" Text="?" Foreground="White" FontSize="11"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="Log File:" Foreground="#AAB4BC" FontSize="11"/>
                <TextBlock x:Name="LogPathText" Grid.Row="7" Grid.Column="3" Text="?" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="LogScroller" Grid.Row="2" Margin="0,10,0,0"
                      Background="#090B0D" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogText" Foreground="#95E6A3" FontSize="10"
                       FontFamily="Consolas" Padding="10" TextWrapping="Wrap"/>
        </ScrollViewer>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Left">
            <Button x:Name="SaveFrameBtn" Content="Save Frame" Style="{StaticResource DebugActionButton}"
                    Click="SaveFrameBtn_Click"/>
            <Button x:Name="OpenFolderBtn" Content="Captures" Style="{StaticResource DebugActionButton}"
                    Click="OpenFolderBtn_Click"/>
            <Button x:Name="OpenLogBtn" Content="Open Log" Style="{StaticResource DebugActionButton}"
                    Click="OpenLogBtn_Click"/>
            <Button x:Name="RefreshLogBtn" Content="Refresh Log" Style="{StaticResource DebugActionButton}"
                    Click="RefreshLogBtn_Click"/>
            <Button x:Name="ClearLogBtn" Content="Clear" Style="{StaticResource DebugActionButton}"
                    Background="#2B1719" BorderBrush="#633139"
                    Click="ClearLogBtn_Click"/>
        </WrapPanel>
    </Grid>
</Window>
